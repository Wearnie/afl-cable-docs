# ============================================================================
# AFL Cable Docs — Environment Variables
# Set these in the Vercel dashboard (Settings → Environment Variables)
# ============================================================================

# GitHub Personal Access Token (fine-grained)
# Required for: DJ mapping admin, cert uploads
# Create at: https://github.com/settings/tokens?type=beta
# Permissions needed: Contents (read + write) on Wearnie/afl-cable-docs
GITHUB_TOKEN=github_pat_xxxxx

# Admin key — any string you choose, shared with AFL staff
# Required for: all admin operations (adding DJ mappings, uploading certs)
ADMIN_KEY=choose-a-secure-key-here

# Optional: GitHub repo (defaults to Wearnie/afl-cable-docs)
# GITHUB_REPO=Wearnie/afl-cable-docs

# Optional: GitHub branch (defaults to main)
# GITHUB_BRANCH=main

# Optional: External document base URL
# When set, documents are loaded from this URL instead of /docs/
# Use this to point at Azure Blob Storage, S3, etc.
# Example: https://aflcabledocs.blob.core.windows.net/docs
# VITE_DOC_BASE_URL=/docs
