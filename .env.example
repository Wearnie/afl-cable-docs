# ============================================================================
# AFL Cable Docs — Environment Variables
# Set these in Azure Static Web Apps (Configuration → Application settings)
# ============================================================================

# ---- Authentication ----

# JWT signing secret — random string, min 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-min-32-chars

# ---- Azure Blob Storage ----

# Connection string for Azure Storage account
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# Optional: container name (defaults to afl-cable-docs)
# AZURE_STORAGE_CONTAINER=afl-cable-docs

# ---- SharePoint Excel Sync (for auto-sync from Print Message workbook) ----
# Create an App Registration in Azure Entra ID (see setup guide below)
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-app-client-id
MICROSOFT_CLIENT_SECRET=your-app-secret

# SharePoint site ID — find via Graph Explorer
# GET https://graph.microsoft.com/v1.0/sites/{hostname}:/{site-path}
SHAREPOINT_SITE_ID=your-site-id

# Path to the Excel file within the SharePoint document library
EXCEL_FILE_PATH=Shared Documents/Print Message.xlsx

# Optional: sheet name (defaults to "Jobpack Database")
# EXCEL_SHEET_NAME=Jobpack Database

# ---- Optional ----

# Optional: CORS origin for write endpoints
# CORS_ORIGIN=https://your-domain.com

# Optional: External document base URL
# VITE_DOC_BASE_URL=/docs
