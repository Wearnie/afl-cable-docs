# ============================================================================
# AFL Cable Docs — Environment Variables
# ============================================================================
#
# Where each var is set depends on when it's consumed:
#
#   • Runtime (Azure Functions)   -> Azure SWA Configuration -> Application settings
#   • Build time (Vite / React)   -> GitHub repo Variable (Settings -> Secrets & variables -> Actions -> Variables)
#   • Deploy pipeline             -> GitHub repo Secret
#   • Local dev                   -> api/local.settings.json  (Functions local runtime)
#                                  -> .env  (Vite; VITE_* vars only)
#
# Bicep (infra/main.bicep) wires the runtime vars into SWA for you at deploy
# time. This file documents the full surface so you can verify nothing is
# missing after `az deployment`.

# ----------------------------------------------------------------------------
# Required — Runtime (Azure Functions)
# ----------------------------------------------------------------------------

# JWT signing secret. Invalidates all sessions when rotated.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Min length: 32 chars
JWT_SECRET=your-jwt-secret-min-32-chars

# Connection string for the Azure Storage account that holds data/ and docs/.
# Bicep outputs this after deploy.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# Set to 'Production' in prod so error messages to the client are sanitised
# to "Internal server error". 'Development' lets full error text through.
AZURE_FUNCTIONS_ENVIRONMENT=Production

# ----------------------------------------------------------------------------
# Optional — Runtime
# ----------------------------------------------------------------------------

# Blob container name. Defaults to afl-cable-docs.
# AZURE_STORAGE_CONTAINER=afl-cable-docs

# ----------------------------------------------------------------------------
# Required — Build time (frontend)
# ----------------------------------------------------------------------------

# Base URL for PDF documents. Points at the blob container + /docs prefix.
# Format: https://<storage-account>.blob.core.windows.net/<container>/docs
# For local dev, leaving unset falls back to /docs served from public/docs/.
#
# SET THIS AS A GITHUB REPO VARIABLE (Settings -> Variables), not a secret.
# The GitHub Actions workflow reads it via `vars.VITE_DOC_BASE_URL` and bakes
# it into the production build.
VITE_DOC_BASE_URL=https://<storage-account>.blob.core.windows.net/afl-cable-docs/docs

# ----------------------------------------------------------------------------
# Required — Deploy pipeline
# ----------------------------------------------------------------------------

# Azure SWA deployment token — paste into GitHub repo Secrets as
# AZURE_SWA_DEPLOY_TOKEN. Read from Azure Portal -> SWA -> Manage deployment
# token, or CLI: `az staticwebapp secrets list --name <swa-name> -o tsv \
#                   --query "properties.apiKey"`
# AZURE_SWA_DEPLOY_TOKEN=<set-in-github-secrets>

# ----------------------------------------------------------------------------
# Optional — Observability
# ----------------------------------------------------------------------------

# Set by the Bicep template when enableMonitoring=true. Not used by the app
# code today; provisioned so you can wire Application Insights when ready.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
